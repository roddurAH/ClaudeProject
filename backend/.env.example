APP_NAME="Krishi Sathi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP defaults: MySQL/MariaDB on 127.0.0.1:3306, user "root", empty password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=krishi_sathi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Krishi Sathi ─────────────────────────────────────────────
KRISHI_HELPLINE=16123
# Shown on the public privacy policy and account-deletion pages (required for Google Play)
KRISHI_OPERATOR_NAME="Krishi Sathi"
KRISHI_SUPPORT_EMAIL=
# Size of one bigha in decimals (shotangsho). 33 is the common standard.
KRISHI_BIGHA_DECIMAL=33
KRISHI_MIN_APP_VERSION=1.0.0
KRISHI_TOKEN_TTL_DAYS=180
# AI crop doctor (see docs/AI_DOCTOR.md). Get a key at https://console.anthropic.com
# KRISHI_AI_DRIVER=demo answers with canned demo replies, for trying the app without a key.
ANTHROPIC_API_KEY=
KRISHI_AI_DRIVER=anthropic
KRISHI_AI_MODEL=claude-opus-5-5
KRISHI_AI_EFFORT=medium
KRISHI_AI_DAILY_LIMIT=10
# Open-Meteo is free without a key for non-commercial use.
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=60
